###############################################################################
# SPDX-License-Identifier: GPL-3.0-only
# PURPOSE: Attempt to guess authentication realms
###############################################################################

our $REALMS;

sub nikto_auth_init {
    my $id = { name        => 'auth',
               full_name   => 'Test Authentication',
               author      => 'Sullo/Tautology',
               description => 'Attempt to guess authentication realms',
               hooks       => {
                          start => { method => \&nikto_auth_load,
                                     weight => 1,
                                     },
                          postfetch => { method => \&nikto_auth,
                                         weight => 19,
                                         cond   => '$response->{whisker}->{code} eq 401',
                                         },
                          prefetch => { method => \&nikto_auth_pre,
                                        weight => 1,
                                        },
                            },
               copyright => "2010 Chris Sullo"
               };

    return $id;
}

# Load up the database as soon as we can
sub nikto_auth_load {

    # Always reload the default-credential DB.
    $REALMS = init_db("db_realms");

    # If the user supplied credentials, try them first
    if (defined $CLI{'hostauth'}) {
        require Text::ParseWords;
        my @array = Text::ParseWords::nested_quotewords(':', 0, $CLI{'hostauth'});

        if (   (defined $array[0][0] && $array[0][0] ne "")
            || (defined $array[0][1] && $array[0][1] ne "")) {

            my $HOSTAUTH = { nikto_id => "700500",
                             realm    => (defined $array[0][2]) ? $array[0][2] : '@ANY',
                             password => $array[0][1] || "",
                             id       => $array[0][0] || "",
                             message  => "Credentials provided via CLI.",
                             };
            unshift(@{$REALMS}, $HOSTAUTH);
        }
    }
}

# Prefetch method can only set a default if it exists, since we don't have
# any returned 401 header. This may mean we send auth headers when they are not
# required, but it shouldn't matter. It also means if there are multiple realms
# the postfetch method will keep changing default...
sub nikto_auth_pre {
    my ($mark, $parameters, $request, $response) = @_;
    if ($mark->{'auth_default'}{'status'}) {
        LW2::auth_set($mark->{'auth_default'}{'authtype'},
                      $request,
                      $mark->{'auth_default'}{'id'},
                      $mark->{'auth_default'}{'password'});
        $request->{'whisker'}->{'allow_short_reads'} = 1;
        LW2::http_fixup_request($request);
    }
    return $request, $response;
}

# Split up www-authenticate to realm and method
sub split_auth_header {
    my $header = $_[0] // return;
    my ($realm, $authtype);

    # Parse auth scheme first, then parameters.
    my ($scheme, $params) = $header =~ /^\s*([A-Za-z]+)\s*(.*)$/;
    return unless defined $scheme;

    if ($scheme =~ /^ntlm$/i) {
        $realm = $authtype = 'ntlm';
        return $realm, $authtype;
    }

    if ($scheme =~ /^basic$/i) {
        $authtype = 'basic';
    }
    elsif ($scheme =~ /^digest$/i) {
        $authtype = 'digest';
    }

    if (defined $params && $params ne "") {
        if ($params =~ /(?:^|,\s*)realm\s*=\s*"([^"]*)"/i) {
            $realm = $1;
        }
        elsif ($params =~ /(?:^|,\s*)realm\s*=\s*([^,\s]+)/i) {
            $realm = $1;
        }
    }

    return $realm, $authtype;
}

# Actual authentication and retry takes place here.
# If present, user-supplied credentials will be tried first
sub nikto_auth {
    my ($mark, $parameters, $request, $response) = @_;

    # Duplicate WWW-Authenticate headers become ARRAY refs
    # (ignore_duplicate_headers=0 in nfetch).
    my $raw_auth = $response->{'www-authenticate'};
    my @auth_hdrs =
      ref($raw_auth) eq 'ARRAY'
      ? grep { defined $_ && $_ ne '' } @{$raw_auth}
      : (defined $raw_auth && $raw_auth ne '' ? ($raw_auth) : ());

    unless (@auth_hdrs) {
        nprint("+ ERROR: No authentication header defined: $response->{'whisker'}->{'uri'}",
               "v", "auth", ($mark->{'hostname'}, $mark->{'ip'}, $mark->{'displayname'}));
        return $request, $response;
    }

    # Prefer schemes LW2::auth_set can send when multiple challenges exist
    my ($realm, $authtype);
    for my $pref (qw(basic ntlm digest)) {
        for my $h (@auth_hdrs) {
            my ($r, $a) = split_auth_header($h);
            next unless defined $a && lc($a) eq $pref;
            ($realm, $authtype) = ($r, $a);
            last;
        }
        last if defined $authtype;
    }
    unless (defined $authtype) {
        ($realm, $authtype) = split_auth_header($auth_hdrs[0]);
    }

    $authtype = 'basic' if (!defined $authtype || $authtype eq '');
    $realm    = ''      if (!defined $realm);

    # did we already test this realm?
    if (exists $mark->{'realms'}{$realm} && exists $mark->{'realms'}{$realm}{'status'}) {
        return $request, $response;
    }

    my $root = $mark->{'root'} // '';
    nprint("+ $response->{'whisker'}->{'uri'} - Requires Authentication for realm '$realm'",
           "", undef, ($mark->{'hostname'}, $mark->{'ip'}, $mark->{'displayname'}))
      if ($OUTPUT{'show_auth'} || $response->{'whisker'}->{'uri'} =~ /^\Q$root\E\/?$/);

    # LW2::auth_set does not support digest — skip rather than probe without Authorization
    if (lc($authtype) eq 'digest') {
        nprint("+ Digest authentication for realm '$realm' is not supported; skipping credential tests",
               "v", "auth", ($mark->{'hostname'}, $mark->{'ip'}, $mark->{'displayname'}));
        $mark->{'realms'}{$realm}{'status'}   = 0;
        $mark->{'realms'}{$realm}{'authtype'} = $authtype;
        return $request, $response;
    }

    # Save to revert (preserve original ARRAY or string shape)
    my $save_auth = $raw_auth;

    # Now we can try the passwords
    nprint("Testing creds for '$realm'",
           "v", "auth", ($mark->{'hostname'}, $mark->{'ip'}, $mark->{'displayname'}));
    my $success = 0;
    foreach my $entry (@{$REALMS}) {
        return if $mark->{'terminate'};
        my $entry_realm   = defined $entry->{'realm'} ? $entry->{'realm'} : '';
        my $realm_matches = ($entry_realm eq '@ANY')
          || (defined $realm && $realm =~ /\Q$entry_realm\E/i);
        unless ($realm_matches) { next; }

        # Set up LW hash
        LW2::auth_set($authtype, $request, $entry->{'id'}, $entry->{'password'});

        # Patch to fix short reads
        $request->{'whisker'}->{'allow_short_reads'} = 1;
        LW2::http_fixup_request($request);

        sleeper();
        LW2::http_do_request_timeout($request, $response);    # test auth
        $COUNTERS{'totalrequests'}++;
        dump_var("Auth Request",  $request,  "auth");
        dump_var("Auth Response", $response, "auth");
        nprint("- Tested credentials: "
                 . $entry->{'id'} . "/"
                 . $entry->{'password'}
                 . "- response: "
                 . $response->{'whisker'}->{'code'},
               "v",
               "auth",
               ($mark->{'hostname'}, $mark->{'ip'}, $mark->{'displayname'})
               );

        $mark->{'realms'}{$realm}{'status'}   = 0;
        $mark->{'realms'}{$realm}{'id'}       = $entry->{'id'};
        $mark->{'realms'}{$realm}{'password'} = $entry->{'password'};
        $mark->{'realms'}{$realm}{'authtype'} = $authtype;

        my $code = $response->{'whisker'}->{'code'} // '';
        if (   ($code !~ /^40[13]$/)
            && !defined $response->{'whisker'}->{'error'}
            && !_www_authenticate_present($response))
        {
            # Snapshot the authenticated exchange before the unauthenticated recheck
            my %auth_whisker  = %{ $response->{'whisker'} };
            my %auth_response = %{$response};
            $auth_response{'whisker'} = \%auth_whisker;

            # Recheck without credentials: FP if URI is open anyway
            LW2::auth_unset($request);
            LW2::http_fixup_request($request);
            sleeper();
            LW2::http_do_request_timeout($request, $response);
            $COUNTERS{'totalrequests'}++;

            my $vcode = $response->{'whisker'}->{'code'} // '';
            if ($vcode =~ /^40[13]$/ || _www_authenticate_present($response)) {

                # Restore authenticated exchange for reporting / default creds
                %{$response} = %auth_response;
                $response->{'whisker'} = \%auth_whisker;
                LW2::auth_set($authtype, $request, $entry->{'id'}, $entry->{'password'});

                my $message;
                my $ref;
                if (($entry->{'message'} // '') eq "Credentials provided via CLI.") {
                    $message =
                      "Successfully authenticated to realm '$realm' with user-supplied credentials.";
                }
                elsif ($entry->{'id'} eq '' && $entry->{'password'} eq '') {
                    $message =
                      "Blank credentials found at $request->{'whisker'}->{uri}, $entry->{'realm'}: $entry->{'message'}.";
                    $ref = "CWE-16";
                }
                else {
                    $message = $request->{'whisker'}->{'uri'}
                      . ": Default account found for '$realm' at (ID '$entry->{'id'}', PW '$entry->{'password'}'). $entry->{message}.";
                    $ref = "CWE-16";
                }

                add_vulnerability($mark, $message, $entry->{'nikto_id'}, $ref, "GET",
                                  $request->{'whisker'}->{'uri'},
                                  $request, $response);

                # Per-mark only — do not mutate global $REALMS entries
                $success                            = 1;
                $mark->{'realms'}{$realm}{'status'} = 1;
                $mark->{'auth_default'}        = $mark->{'realms'}{$realm};
                last;
            }
            nprint("- Auth success looked like a false positive (URI open without credentials)",
                   "v", "auth",
                   ($mark->{'hostname'}, $mark->{'ip'}, $mark->{'displayname'}));
        }
        $response->{'www-authenticate'} = $save_auth;
    }
    LW2::auth_unset($request);

    # Record that we've processed this realm even when nothing matched, so a
    # later 401 for the same realm doesn't trigger a full re-test.
    $mark->{'realms'}{$realm}{'status'} //= 0;

    if (!$success) {
        nprint("+ " . $request->{'whisker'}->{'uri'} . ": No creds found for realm '$realm'",
               "", undef, ($mark->{'hostname'}, $mark->{'ip'}, $mark->{'displayname'}));
    }

    return $request, $response;
}

# True if WWW-Authenticate is present (string or ARRAY from duplicate headers).
sub _www_authenticate_present {
    my ($response) = @_;
    my $h = $response->{'www-authenticate'};
    return 0 unless defined $h;
    if (ref($h) eq 'ARRAY') {
        return scalar(grep { defined $_ && $_ ne '' } @{$h}) ? 1 : 0;
    }
    return $h ne '' ? 1 : 0;
}

1;

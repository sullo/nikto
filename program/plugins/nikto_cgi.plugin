###############################################################################
# SPDX-License-Identifier: GPL-3.0-only
# PURPOSE: Perform CGI tests
###############################################################################
sub nikto_cgi_init {
    my $id = { name        => "cgi",
               full_name   => "CGI",
               author      => "Sullo",
               description => "Enumerates possible CGI directories.",
               hooks       => { recon => { method => \&nikto_cgi, }, },
               copyright   => "2008 Chris Sullo",
               };
    return $id;
}

sub nikto_cgi {
    my ($mark) = @_;
    my $gotvalid = 0;
    my @POSSIBLECGI;
    # Baseline catalog (global / prior path learning on this mark)
    my @CFGCGI = grep { $_ ne '' } split(' ', get_catalog_var($mark, '@CGIDIRS'));

    # @CGIDIRS already set from -Cgidirs in nikto.pl; only log / probe here
    if (defined $CLI{'forcecgi'}) {
        if ($CLI{'forcecgi'} eq "all") {
            nprint("Using all known CGI directories\n", "d");
        }
        elsif ($CLI{'forcecgi'} eq "none") {
            nprint("- No CGI directories are set\n", "v", "cgi");
        }
        else {
            nprint("Using CGI dir '$CLI{'forcecgi'}'\n", "d");
        }
    }
    else    # or normal testing of each dir
    {
        foreach my $possiblecgidir (@CFGCGI) {
            return if $mark->{'terminate'};
            my ($res, $content, $error, $request, $response) =
              nfetch($mark, $possiblecgidir, "GET", "", "", "", "CGI");
            $res     = '' unless defined $res;
            $content = '' unless defined $content;
            nprint("Checked for CGI dir\t$possiblecgidir\tgot:$res",
                   "d", "cgi", ($mark->{'hostname'}, $mark->{'ip'}, $mark->{'displayname'}));

            # Failed / incomplete probe -- do not treat as a CGI directory
            next if $res eq '';

            my $is_index =
              ($res eq "200" && $content =~ /(?:index of \/|directory listing (?:of|for))/i);
            if (($res =~ /^40[135]$/ || $is_index)
                && !is_404($mark, ($mark->{'root'} // '') . $possiblecgidir, $response)) {
                $gotvalid++;
                push @POSSIBLECGI, $possiblecgidir;
            }
        }

        if ($gotvalid == 0) {
            nprint(
                "+ No CGI Directories found (use '-Cgidirs all' to force check all possible dirs). CGI tests skipped."
                );
            set_catalog_var($mark, '@CGIDIRS', '');
        }
        elsif (scalar(@CFGCGI) == scalar(@POSSIBLECGI)) {
            nprint("+ All CGI directories 'found', use '-Cgidirs none' to test none");
            set_catalog_var($mark, '@CGIDIRS', join(" ", @CFGCGI));
        }
        else {
            set_catalog_var($mark, '@CGIDIRS', join(" ", @POSSIBLECGI));
        }
    }

    nprint("- Checking for CGI in: " . get_catalog_var($mark, '@CGIDIRS'), "v", "cgi");
}

1;

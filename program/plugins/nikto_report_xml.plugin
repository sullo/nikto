###############################################################################
# SPDX-License-Identifier: GPL-3.0-only
# PURPOSE: XML Reporting - Multi-host support with proper XML handling
###############################################################################
our $XMLRPT_ALL  = [];       # Arrayref to hold all hosts' reports
our $XMLRPT_CURR = undef;    # Scalarref to current host's report
our $XML_WRITER  = undef;    # XML::Writer instance
our $XML_HANDLE  = undef;    # File handle
our $XML_FILE    = undef;    # Output filename for validation

use XML::Writer;
use Time::Piece;
use Time::Seconds;

###############################################################################
sub nikto_report_xml_init {
    my $id = { name              => "report_xml",
               full_name         => "XML reports (v2)",
               author            => "Sullo",
               description       => "Produces a proper XML report with validation.",
               report_head       => \&xml_open,
               report_host_start => \&xml_host_start,
               report_host_end   => \&xml_host_end,
               report_close      => \&xml_close,
               report_item       => \&xml_item,
               report_ssl_info   => \&xml_ssl_info,
               report_format     => 'xml',
               copyright         => "2025 Chris Sullo"
               };
    return $id;
}

###############################################################################
# Strip XML 1.0 illegal controls (XML::Writer does not)
sub xml_safe {
    my ($s) = @_;
    $s = '' unless defined $s;
    $s =~ s/[\x00-\x08\x0B\x0C\x0E-\x1F]//g;
    return $s;
}

###############################################################################
# Bracket IPv6 literals for use in URLs (http://[::1]:80/) — same rules as HTML
sub xml_url_host {
    my ($host) = @_;
    return '' unless defined $host && $host ne '';
    $host =~ s/^\[//;
    $host =~ s/\]$//;
    if ($host =~ /^$LW2::IPv6_re_inc_zoneid$/ || $host =~ /:/) {
        return '[' . $host . ']';
    }
    return $host;
}

###############################################################################
sub xml_site_url {
    my ($protocol, $host, $port, $root) = @_;
    my $h = xml_url_host($host);
    return '' if $h eq '';
    $port = $port // '';
    $root = $root // '';
    my $url = "$protocol://$h:$port$root";
    $url .= '/' unless $url =~ /\/$/;
    return $url;
}

###############################################################################
# open output file
sub xml_open {
    my ($file) = @_;
    if ($file eq '') {
        die "+ ERROR: Output file not specified.\n";
    }

    # Open file with lexical handle for writing
    my $fh;
    open($fh, ">", $file) || die "+ ERROR: Unable to open '$file' for write: $!\n";

    # Enable autoflush
    $fh->autoflush(1);

    # Store lexical handle reference in package variable
    $XML_HANDLE = $fh;
    $XML_FILE   = $file;

    # Initialize XML writer with proper settings
    $XML_WRITER = XML::Writer->new(OUTPUT      => $fh,
                                   DATA_MODE   => 1,
                                   DATA_INDENT => 2,
                                   ENCODING    => 'UTF-8',
                                   UNSAFE      => 0          # Ensure proper escaping
                                   );

    # Write XML declaration
    $XML_WRITER->xmlDecl('UTF-8');

    # Write DOCTYPE if DTD is defined
    if (defined $CONFIGFILE{'NIKTODTD'} && $CONFIGFILE{'NIKTODTD'} ne '') {

        # Resolve DTD path relative to Nikto execution directory
        my $dtd_path = $CONFIGFILE{'NIKTODTD'};
        if ($dtd_path !~ /^\// && defined $CONFIGFILE{'EXECDIR'}) {
            $dtd_path = "$CONFIGFILE{'EXECDIR'}/$dtd_path";
        }
        $XML_WRITER->doctype('niktoscans', 'SYSTEM', $dtd_path);
    }

    # Start root element; niktoscan children are written at close so
    # scan-level attributes and host error counts are complete.
    $XML_WRITER->startTag('niktoscans');

    nprint("- XML report initialized with proper encoding and structure", "v", "report_xml");
    return $fh;
}

###############################################################################
# start host entry (buffered; tags are written in xml_close)
sub xml_host_start {
    my ($handle, $mark) = @_;

    my $protocol = $mark->{'ssl'} ? 'https' : 'http';
    my $hostname = $mark->{'vhost'} || $mark->{'hostname'} || '';
    my $root     = $mark->{'root'}  // '';
    my $port     = $mark->{'port'}  // '';

    $XMLRPT_CURR = { targetip       => $mark->{'ip'}       // '',
                     targethostname => $mark->{'hostname'} // '',
                     targetport     => $port,
                     targetbanner   => $mark->{'banner'}   || '',
                     starttime      => date_disp($mark->{'start_time'}),
                     hostheader     => $hostname,
                     errors         => 0,
                     checks         => $COUNTERS{'total_checks'} || 0,
                     items          => [],
                     ssl_info       => undef,
                     protocol       => $protocol,
                     root           => $root
                     };

    $XMLRPT_CURR->{'siteip'} = xml_site_url($protocol, $mark->{'ip'}, $port, $root);
    my $sitename = xml_site_url($protocol, $hostname, $port, $root);
    $XMLRPT_CURR->{'sitename'} = $sitename ne '' ? $sitename : 'N/A';

    push(@$XMLRPT_ALL, $XMLRPT_CURR);

    nprint("- XML host entry started for $mark->{'hostname'}", "v", "report_xml");
}

###############################################################################
# write SSL info
sub xml_ssl_info {
    my ($handle, $mark) = @_;
    return unless defined $XMLRPT_CURR;

    # Extract CN from subject. RDNs are separated by ',' or '/', and a CN may
    # legitimately contain spaces, so only those two are terminators.
    my $cn = '';
    if (defined $mark->{'ssl_cert_subject'}
        && $mark->{'ssl_cert_subject'} =~ /\bCN\s*=\s*([^,\/]+)/i) {
        $cn = $1;
        $cn =~ s/^\s+|\s+$//g;
    }

    $XMLRPT_CURR->{'ssl_info'} = { ciphers  => $mark->{'ssl_cipher'}        || '',
                                   issuers  => $mark->{'ssl_cert_issuer'}   || '',
                                   info     => $mark->{'ssl_cert_subject'}  || '',
                                   cn       => $cn,
                                   altnames => $mark->{'ssl_cert_altnames'} || ''
                                   };
}

###############################################################################
# end host entry — snapshot values that are only known after the scan
sub xml_host_end {
    my ($handle, $mark) = @_;
    return unless defined $XMLRPT_CURR;

    my $end =
      (defined $mark->{'end_time'} && $mark->{'end_time'} ne '')
      ? $mark->{'end_time'}
      : time();
    my $start = $mark->{'start_time'};

    $XMLRPT_CURR->{'endtime'}    = date_disp($end);
    $XMLRPT_CURR->{'elapsed'}    = (defined $start ? ($end - $start) : 0);
    $XMLRPT_CURR->{'itemsfound'} = $mark->{'total_vulns'}  || 0;
    $XMLRPT_CURR->{'errors'}     = $mark->{'total_errors'} || 0;
    $XMLRPT_CURR->{'checks'}     = $COUNTERS{'total_checks'} || $XMLRPT_CURR->{'checks'} || 0;

    nprint("- XML host entry completed for $mark->{'hostname'}", "v", "report_xml");
}

###############################################################################
# add item to current host
sub xml_item {
    my ($handle, $mark, $item) = @_;
    return unless defined $XMLRPT_CURR;

    my $uri  = $item->{'uri'}  // '';
    my $root = $mark->{'root'} // $XMLRPT_CURR->{'root'} // '';
    if ($uri ne '' && $root ne '' && $uri !~ /^\Q$root\E(?:\/|$)/) {
        $uri = $root . $uri;
    }

    my $protocol  = $mark->{'ssl'} ? 'https' : ($XMLRPT_CURR->{'protocol'} || 'http');
    my $port      = $mark->{'port'} // $XMLRPT_CURR->{'targetport'} // '';
    my $name_host = $mark->{'vhost'} || $mark->{'hostname'} || $mark->{'ip'} || '';
    my $namelink  = $protocol . '://' . xml_url_host($name_host) . ':' . $port . $uri;
    my $iplink    = $protocol . '://' . xml_url_host($mark->{'ip'}) . ':' . $port . $uri;

    push(@{ $XMLRPT_CURR->{'items'} },
         {  id          => $item->{'nikto_id'} || '',
            method      => $item->{'method'}   || '',
            description => $item->{'message'}  || '',
            uri         => $uri,
            namelink    => $namelink,
            iplink      => $iplink,
            references  => $item->{'refs'} || ''
            }
         );
}

###############################################################################
# Emit one buffered host as niktoscan/scandetails
sub xml_write_host {
    my ($host, $hoststest) = @_;
    return unless defined $XML_WRITER && defined $host;

    my $scanstart =
      $COUNTERS{'scan_start'} ? localtime($COUNTERS{'scan_start'}) : '';
    my $scanend =
      $COUNTERS{'scan_end'} ? localtime($COUNTERS{'scan_end'}) : localtime;

    $XML_WRITER->startTag('niktoscan',
                          hoststest   => xml_safe($hoststest),
                          options     => xml_safe($CLI{'all_options'}  || ''),
                          version     => xml_safe($VARIABLES{'version'} || 'unknown'),
                          scanstart   => xml_safe($scanstart),
                          scanend     => xml_safe($scanend),
                          scanelapsed => xml_safe($COUNTERS{'scan_elapsed'} || 0),
                          nxmlversion => "1.3"
                          );

    $XML_WRITER->startTag('scandetails',
                          targetip       => xml_safe($host->{'targetip'}),
                          targethostname => xml_safe($host->{'targethostname'}),
                          targetport     => xml_safe($host->{'targetport'}),
                          targetbanner   => xml_safe($host->{'targetbanner'}),
                          starttime      => xml_safe($host->{'starttime'}),
                          sitename       => xml_safe($host->{'sitename'}),
                          siteip         => xml_safe($host->{'siteip'}),
                          hostheader     => xml_safe($host->{'hostheader'}),
                          errors         => xml_safe($host->{'errors'}),
                          checks         => xml_safe($host->{'checks'})
                          );

    if (defined $host->{'ssl_info'}) {
        $XML_WRITER->emptyTag('ssl',
                              ciphers  => xml_safe($host->{'ssl_info'}->{'ciphers'}),
                              issuers  => xml_safe($host->{'ssl_info'}->{'issuers'}),
                              info     => xml_safe($host->{'ssl_info'}->{'info'}),
                              cn       => xml_safe($host->{'ssl_info'}->{'cn'}),
                              altnames => xml_safe($host->{'ssl_info'}->{'altnames'})
                              );
    }

    foreach my $it (@{ $host->{'items'} || [] }) {
        $XML_WRITER->startTag('item',
                              id     => xml_safe($it->{'id'}),
                              method => xml_safe($it->{'method'}));
        $XML_WRITER->dataElement('description', xml_safe($it->{'description'}));
        $XML_WRITER->dataElement('uri',         xml_safe($it->{'uri'}));
        $XML_WRITER->dataElement('namelink',    xml_safe($it->{'namelink'}));
        $XML_WRITER->dataElement('iplink',      xml_safe($it->{'iplink'}));
        $XML_WRITER->dataElement('references',  xml_safe($it->{'references'}));
        $XML_WRITER->endTag('item');
    }

    $XML_WRITER->emptyTag('statistics',
                          elapsed     => xml_safe($host->{'elapsed'}    // 0),
                          itemsfound  => xml_safe($host->{'itemsfound'} // 0),
                          itemstested => xml_safe($host->{'checks'}     // 0),
                          endtime     => xml_safe($host->{'endtime'}    || '')
                          );

    $XML_WRITER->endTag('scandetails');
    $XML_WRITER->endTag('niktoscan');
}

###############################################################################
# close output file
sub xml_close {
    my ($handle) = @_;
    return unless defined $XML_WRITER;

    my $hoststest = 0;
    foreach my $host (@$XMLRPT_ALL) {
        $hoststest++;
        xml_write_host($host, $hoststest);
    }

    eval {
        $XML_WRITER->endTag('niktoscans');
        $XML_WRITER->end();
        1;
    };
    $XML_WRITER  = undef;
    close($XML_HANDLE) if $XML_HANDLE;
    $XML_HANDLE  = undef;
    $XMLRPT_ALL  = [];
    $XMLRPT_CURR = undef;

    xml_validate_output($XML_FILE) if defined $XML_FILE && $XML_FILE ne '';
    $XML_FILE = undef;

    nprint("- XML report completed with proper structure", "v", "report_xml");
}

###############################################################################
# Validate XML output
sub xml_validate_output {
    my ($filename) = @_;

    # Only validate if XML::LibXML is available
    eval {
        require XML::LibXML;

        my $parser = XML::LibXML->new();
        my $doc    = $parser->parse_file($filename);

        # Validate against DTD if available
        if (defined $CONFIGFILE{'NIKTODTD'} && $CONFIGFILE{'NIKTODTD'} ne '') {
            $doc->validate();
            nprint("- XML output validated against DTD successfully", "v", "report_xml");
        }
        else {
            nprint("- XML output is well-formed", "v", "report_xml");
        }
    };
    if ($@) {
        nprint("+ WARNING: XML validation failed: $@", "e");
    }
}

sub nikto_reports { }    # so core doesn't freak

1;

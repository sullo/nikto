###############################################################################
# SPDX-License-Identifier: GPL-3.0-only
# PURPOSE: Scan for exposed Spring Boot Actuator endpoints and basic info leaks
###############################################################################

use JSON::PP;

sub nikto_springboot_init {
    my $id = { name        => "springboot",
               full_name   => "Spring Boot Actuator endpoint check",
               author      => "Sullo",
               description => "Detects exposed Spring Boot Actuator endpoints and basic info leaks",
               hooks       => { scan => { method => \&nikto_springboot, } },
               copyright   => "2025 Chris Sullo"
               };
    return $id;
}

sub nikto_springboot {
    my ($mark) = @_;
    return if $mark->{'terminate'};

    # Paths are root-relative; nfetch prepends $mark->{'root'}
    my @endpoints = qw(
      /actuator
      /actuator/health
      /actuator/info
      /actuator/env
      /actuator/mappings
      /actuator/metrics
      /actuator/beans
      /actuator/configprops
      /actuator/loggers
      /actuator/threaddump
      /actuator/auditevents
      /actuator/httptrace
      /actuator/scheduledtasks
      /actuator/heapdump
      /actuator/jolokia
      /actuator/prometheus
      );

    my $port = $mark->{'port'} // '';
    my $host_re =
      join('|', map { quotemeta($_) }
          grep { defined $_ && $_ ne '' }
          ($mark->{'hostname'}, $mark->{'ip'}, $mark->{'vhost'}, $mark->{'ident'}));
    my $port_re = ($port ne '' && $port ne '80' && $port ne '443')
      ? '(?::' . quotemeta($port) . ')?'
      : '(?::(?:80|443))?';

    foreach my $ep (@endpoints) {
        return if $mark->{'terminate'};
        nprint("Checking $ep", "v", "springboot");
        my ($res, $content, $error, $request, $response) =
          nfetch($mark, $ep, 'GET', '', '', undef, 'springboot');
        $content //= '';

        my $ct = '';
        if (ref($response) eq 'HASH' && defined $response->{'content-type'}) {
            $ct = $response->{'content-type'};
            $ct = join(', ', grep { defined $_ && $_ ne '' } @$ct) if ref($ct) eq 'ARRAY';
        }

        # Quick exits
        if (($res // '') eq '404') {
            next;
        }
        elsif (($res // '') ne '200') {
            nprint("$ep: Non-200 ($res) - possibly restricted endpoint", "v", "springboot");
            next;
        }

        # heapdump is application/octet-stream (HPROF), not JSON
        if ($ep eq '/actuator/heapdump') {
            if ($ct =~ /octet-stream/i || $content =~ /\AJAVA PROFILE/) {
                add_vulnerability(
                    $mark,
                    "$ep: Spring Boot Actuator heapdump endpoint exposed",
                    "750004",
                    "https://docs.spring.io/spring-boot/docs/current/actuator-api/html/#heapdump",
                    "GET", $ep, $request, $response
                );
            }
            next;
        }

        # prometheus exposition format is text/plain, not JSON
        if ($ep eq '/actuator/prometheus') {
            if (   $ct =~ /openmetrics|prometheus/i
                || $content =~ /(?:^|\n)#\s*(?:HELP|TYPE)\s/)
            {
                add_vulnerability(
                    $mark,
                    "$ep: Spring Boot Actuator prometheus endpoint exposed",
                    "750004",
                    "https://docs.spring.io/spring-boot/docs/current/actuator-api/html/#prometheus",
                    "GET", $ep, $request, $response
                );
            }
            next;
        }

        # remaining responses should be JSON
        next unless ($ct =~ /application\/json/i || $content =~ /^\s*[\{\[]/);

        my $json;
        eval { $json = decode_json($content); };
        if ($@ || ref($json) ne 'HASH') {
            nprint("$ep: 200 but not a JSON object", "v", "springboot");
            next;
        }

        # /actuator special handling
        if ($ep eq '/actuator') {
            if (exists $json->{'_links'} && ref($json->{'_links'}) eq 'HASH') {
                my $links = $json->{'_links'};
                foreach my $k (keys %$links) {
                    next unless ref($links->{$k}) eq 'HASH';
                    my $href = $links->{$k}{'href'};
                    next unless defined $href && $href ne '';
                    my $report_val;

                    # Same-host http(s) → path only. Off-host / other schemes:
                    # name the link, never echo the attacker-controlled href.
                    if ($host_re ne ''
                        && $href =~ m{^https?://(?:$host_re)$port_re(/.*)$}i) {
                        $report_val = $1;
                    }
                    elsif ($href =~ m{^/}) {
                        $report_val = $href;
                    }
                    else {
                        $report_val = $k;
                    }
                    $report_val = nikto_springboot_safe_str($report_val);
                    next unless length($report_val);
                    if ($report_val =~ m{^[a-z][a-z0-9+.-]*:}i || $report_val =~ /\s/) {
                        $report_val = nikto_springboot_safe_str($k);
                        next unless length($report_val);
                    }
                    add_vulnerability(
                        $mark,
                        "$report_val: Spring Boot Actuator endpoint discovered via /actuator _links.",
                        "750001",
                        "https://docs.spring.io/spring-boot/docs/current/actuator-api/html/",
                        "GET",
                        $report_val,
                        $request,
                        $response
                        );
                }
            }
            else {
                nprint("/actuator: 200 but no _links", "v", "springboot");
            }
            next;
        }

        # /actuator/health
        if ($ep eq '/actuator/health') {
            if (exists $json->{'status'} && ($json->{'status'} // '') eq 'UP') {
                add_vulnerability(
                        $mark,
                        "$ep: Spring Boot Actuator health endpoint exposed",
                        "750002",
                        "https://docs.spring.io/spring-boot/docs/current/actuator-api/html/#health",
                        "GET",
                        $ep,
                        $request,
                        $response
                        );
            }
            next;
        }

        # /actuator/info
        if ($ep eq '/actuator/info') {
            if (   exists $json->{'build'}
                && ref($json->{'build'}) eq 'HASH'
                && exists $json->{'build'}{'version'}) {
                my $ver = $json->{'build'}{'version'} // '';
                add_vulnerability(
                    $mark,
                    "$ep: Spring Boot Actuator info endpoint exposed (build version: $ver)",
                    "750003",
                    "https://docs.spring.io/spring-boot/docs/current/actuator-api/html/#info",
                    "GET",
                    $ep,
                    $request,
                    $response
                    );
            }
            next;
        }

        # Other endpoints: report if valid, non-empty JSON
        if (ref($json) eq 'HASH' && scalar(keys %$json) > 0) {
            add_vulnerability(
                     $mark,  "$ep: Spring Boot Actuator endpoint exposed (valid JSON response)",
                     "750004", "https://docs.spring.io/spring-boot/docs/current/actuator-api/html/",
                     "GET",    $ep,
                     $request, $response
                     );
        }
    }
}

# Strip controls / limit length so untrusted actuator JSON cannot break reports
sub nikto_springboot_safe_str {
    my ($s) = @_;
    $s = '' unless defined $s;
    $s =~ s/[\x00-\x1f\x7f]//g;
    return length($s) > 256 ? substr($s, 0, 256) : $s;
}

1;

###############################################################################
# SPDX-License-Identifier: GPL-3.0-only
# PURPOSE: Scan for OPTIONSBLEED (CVE-2017-9798)
###############################################################################

sub nikto_optionsbleed_init {
    my $id = { name        => "optionsbleed",
               full_name   => "OPTIONSBLEED (CVE-2017-9798) check",
               author      => "Sullo",
               description => "Detects OPTIONSBLEED vulnerability (CVE-2017-9798)",
               hooks       => { scan => { method => \&nikto_optionsbleed, } },
               copyright   => "2025 Chris Sullo"
               };
    return $id;
}

sub nikto_optionsbleed {
    my ($mark)       = @_;
    my $num_requests = 50;                       # Number of OPTIONS requests to send
    my $path         = '/';                      # nfetch prepends $mark->{'root'}

    for (my $i = 0 ; $i < $num_requests ; $i++) {
        return if $mark->{'terminate'};
        my ($res, $content, $error, $request, $response) =
          nfetch($mark, $path, 'OPTIONS', '', '', undef, 'optionsbleed');

        # Transport / incomplete response — keep trying (bleed is intermittent)
        next unless defined $res && $res ne '' && ref($response) eq 'HASH';

        # Duplicate headers become ARRAY refs (ignore_duplicate_headers=0 in nfetch).
        my $allow =
          ref($response->{'allow'}) eq 'ARRAY'
          ? join(', ', grep { defined $_ && $_ ne '' } @{ $response->{'allow'} })
          : ($response->{'allow'} // '');

        # No Allow header — nothing to inspect on this host
        if ($allow eq '') {
            last;
        }

        # Allow is 1#method; method is a token (RFC 7230 tchar) or *. OPTIONSBLEED
        # leaks memory (controls, ':', garbage) — not WebDAV/UPnP/CORS methods.
        if ($allow =~ /[^\t !#\$%&'*+\-.0-9A-Za-z^_`|~,]/ || $allow =~ /,,+/) {
            add_vulnerability($mark,
                       "$path: Potential OPTIONSBLEED vulnerability detected. Allow header: $allow",
                       "740002", "CVE-2017-9798", 'OPTIONS', $path, $request, $response,
                       "Allow header value is not a comma-separated method list");
            return;
        }
    }
}

1;

###############################################################################
# SPDX-License-Identifier: GPL-3.0-only
# PURPOSE: Various messages relating to the server banner
###############################################################################
use vars qw/$MSGS_DB/;

# NOTES:
# versions are loaded from the "db_server_msgs" file, which should be in the
# plugins directory this plugin checks the server version to see if there are
# any version specific items in the db_server_msgs this differs from
# nikto_outdated because that is ONLY checking to see if it is an old version,
# whereas this checks to see if the versions match
###############################################################################
sub nikto_msgs_init {
    my $id = { name        => "msgs",
               full_name   => "Server Messages",
               author      => "Sullo",
               description => "Checks the server version against known issues.",
               hooks       => {
                          start => { method => \&nikto_msgs_load, },
                          scan  => {method => \&nikto_msgs,
                                    weight => 5,
                                    },
                            },
               copyright => "2008 Chris Sullo"
               };
    return $id;
}

sub nikto_msgs_load {
    $MSGS_DB = init_db("db_server_msgs");
}

sub nikto_msgs {
    my ($mark) = @_;
    return if $mark->{'terminate'};
    my $dbarray = $MSGS_DB || init_db("db_server_msgs");
    my $banner  = $mark->{'banner'} // '';

    foreach my $item (@$dbarray) {
        # Do not mutate the shared DB entry
        my $server_re = validate_and_fix_regex($item->{'server'});
        # \b after the DB regex breaks patterns that end on a non-word char
        # (Ews/, [^0-9], .*). Require a boundary only when the match ends on \w.
        if ($banner =~ /($server_re)(?(?<=\w)\b)/i) {
            my $matched = $1;
            add_vulnerability($mark, "/: $matched - $item->{'message'}",
                              $item->{'nikto_id'}, $item->{'refs'});
        }
    }

    # Special stuff to pull information from results
    # McAfee ePO
    if ($banner =~ /Agent-ListenServer-HttpSvr\/1\.0\b/i) {
        return if $mark->{'terminate'};
        my ($res, $content, $error, $request, $response) =
          nfetch($mark, "/_LOGFILENAME_", "GET", "", "", "", "msgs: Agent-ListenServer-HttpSvr");

        if (($res // '') eq '200') {
            my ($name)       = $content =~ /<ComputerName>([^<]+)<\/ComputerName>/;
            my ($eposerver) = $content =~ /<ePOServerName>([^<]+)<\/ePOServerName>/;
            if (defined $name && $name ne '') {
                $eposerver = '' unless defined $eposerver;
                add_vulnerability(
                    $mark,
                    "/_LOGFILENAME_: Web server is a McAfee ePO agent and showing the hostname as '$name' and the ePO server(s) as '$eposerver'.",
                    "980100",
                    "https://www.mcafee.com/enterprise/en-us/downloads/trials/epo-mcafee-agent-deployment.html",
                    "GET",
                    "/_LOGFILENAME_",
                    $request,
                    $response
                    );
            }
            else {
                add_vulnerability(
                    $mark,
                    "/_LOGFILENAME_: Web server is a McAfee ePO agent.",
                    "000435",
                    "https://www.mcafee.com/enterprise/en-us/downloads/trials/epo-mcafee-agent-deployment.html",
                    "GET",
                    "/_LOGFILENAME_",
                    $request,
                    $response
                    );
            }
        }
    }

    # HP WBEM
    if ($banner =~ /CompaqHTTPServer/i) {
        return if $mark->{'terminate'};
        my ($res, $content, $error, $request, $response) =
          nfetch($mark, "/cpqlogin.htm", "GET", "", "", "", "msgs: CompaqHTTPServer");

        if (($res // '') eq '200') {
            my $ipaddrs = "";
            my $name;
            foreach my $line (split(/\n/, $content)) {
                if ($line =~ /System Management Homepage for ([a-zA-Z0-9]+)/) {
                    $name = $1;
                }
                if ($line =~ /new ObjectIpAddresses\("([\d\.]+)"\)/) {
                    my $ipaddr = $1;
                    nprint("$ipaddr", "", undef,
                           ($mark->{'hostname'}, $mark->{'ip'}, $mark->{'displayname'}));
                    $ipaddrs .= " $ipaddr";
                }
            }
            if (defined $name && $name ne '' && $ipaddrs ne '') {
                add_vulnerability(
                    $mark,
                    "/cpqlogin.htm: Web server is an HP WBEM agent and showing the hostname is $name and the IP addresses are $ipaddrs.",
                    "801010",
                    "",
                    "GET",
                    "/cpqlogin.htm",
                    $request,
                    $response
                    );
            }
        }
    }
}

1;

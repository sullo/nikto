###############################################################################
# SPDX-License-Identifier: GPL-3.0-only
# PURPOSE: CSV Reporting
###############################################################################
sub nikto_report_csv_init {
    my $id = { name              => "report_csv",
               full_name         => "CSV reports",
               author            => "Tautology",
               description       => "Produces a CSV report.",
               report_head       => \&csv_open,
               report_host_start => \&csv_host_start,
               report_item       => \&csv_item,
               report_ssl_info   => \&csv_ssl_info,
               report_format     => 'csv',
               copyright         => "2008 Chris Sullo"
               };
    return $id;
}

###############################################################################
# open output file
sub csv_open {
    my ($file) = @_;
    if ($file eq '') {
        print STDERR "+ ERROR: Output file not specified.\n";
        exit;
    }

    # Open file with lexical handle and produce header
    my $fh;
    open($fh, ">>", $file) || die "+ ERROR: Unable to open '$file' for write: $!\n";

    # Enable autoflush
    $fh->autoflush(1);

    # Write header
    print $fh "\"$VARIABLES{'name'} - v$VARIABLES{'version'}/$VARIABLES{'core_version'}\"\n";
    return $fh;
}

###############################################################################
# start output
sub csv_host_start {
    my ($handle, $mark) = @_;
    my $banner   = $mark->{'banner'} // '';
    my $hostname = $mark->{'vhost'} ? $mark->{'vhost'} : $mark->{'hostname'};
    print $handle "\""
      . csv_safecell($hostname) . "\"," . "\""
      . csv_safecell($mark->{'ip'}) . "\"," . "\""
      . csv_safecell($mark->{'port'}) . "\"," . "\"\"," . "\"\"," . "\"\"," . "\""
      . csv_safecell($banner) . "\"\n";
    return;
}

###############################################################################
# write SSL info
sub csv_ssl_info {
    my ($handle, $mark) = @_;
    my $ssl_hostname = $mark->{'vhost'} ? $mark->{'vhost'} : $mark->{'hostname'};

    # SSL Subject
    print $handle "\""
      . csv_safecell($ssl_hostname) . "\"," . "\""
      . csv_safecell($mark->{'ip'}) . "\"," . "\""
      . csv_safecell($mark->{'port'}) . "\","
      . "\"000137\","
      . "\"GET\","
      . "\"/\"," . "\""
      . csv_safecell("SSL Certificate Subject: " . ($mark->{'ssl_cert_subject'} || '')) . "\"\n";

    # SSL CN if present. RDNs are separated by ',' or '/', and a CN may
    # legitimately contain spaces, so only those two are terminators.
    if (defined $mark->{'ssl_cert_subject'}
        && $mark->{'ssl_cert_subject'} =~ /\bCN\s*=\s*([^,\/]+)/i) {
        my $cn = $1;
        $cn =~ s/^\s+|\s+$//g;
        print $handle "\""
          . csv_safecell($ssl_hostname) . "\"," . "\""
          . csv_safecell($mark->{'ip'}) . "\"," . "\""
          . csv_safecell($mark->{'port'}) . "\","
          . "\"000137\","
          . "\"GET\","
          . "\"/\"," . "\""
          . csv_safecell("SSL Certificate CN: $cn") . "\"\n";
    }

    # SSL SAN if present
    if (defined $mark->{'ssl_cert_altnames'} && $mark->{'ssl_cert_altnames'} ne '') {
        print $handle "\""
          . csv_safecell($ssl_hostname) . "\"," . "\""
          . csv_safecell($mark->{'ip'}) . "\"," . "\""
          . csv_safecell($mark->{'port'}) . "\","
          . "\"000137\","
          . "\"GET\","
          . "\"/\"," . "\""
          . csv_safecell("SSL Certificate SAN: " . $mark->{'ssl_cert_altnames'}) . "\"\n";
    }

    # SSL Ciphers
    print $handle "\""
      . csv_safecell($ssl_hostname) . "\"," . "\""
      . csv_safecell($mark->{'ip'}) . "\"," . "\""
      . csv_safecell($mark->{'port'}) . "\","
      . "\"000137\","
      . "\"GET\","
      . "\"/\"," . "\""
      . csv_safecell("SSL Ciphers: " . ($mark->{'ssl_cipher'} || '')) . "\"\n";

    # SSL Issuer
    print $handle "\""
      . csv_safecell($ssl_hostname) . "\"," . "\""
      . csv_safecell($mark->{'ip'}) . "\"," . "\""
      . csv_safecell($mark->{'port'}) . "\","
      . "\"000137\","
      . "\"GET\","
      . "\"/\"," . "\""
      . csv_safecell("SSL Certificate Issuer: " . ($mark->{'ssl_cert_issuer'} || '')) . "\"\n";
}

###############################################################################
# print an item
sub csv_item {
    my ($handle, $mark, $item) = @_;
    foreach my $uri (split(' ', $item->{'uri'} // '')) {
        my $line = '';
        my $hostname =
          $item->{'mark'}->{'vhost'} ? $item->{'mark'}->{'vhost'} : $item->{'mark'}->{'hostname'};
        $line .= "\"" . csv_safecell($hostname) . "\",";
        $line .= "\"" . csv_safecell($item->{'mark'}->{'ip'}) . "\",";
        $line .= "\"" . csv_safecell($item->{'mark'}->{'port'}) . "\",";
        $line .= "\"" . csv_safecell($item->{'refs'}) . "\",";
        $line .= "\"" . csv_safecell($item->{'method'}) . "\",";

        my $root     = $mark->{'root'} // '';
        my $full_uri = $uri;
        if ($uri ne '' && $root ne '' && $uri !~ /^\Q$root\E(?:\/|$)/) {
            $full_uri = $root . $uri;
        }
        $line .= "\"" . csv_safecell($full_uri) . "\",";

        my $msg          = $item->{'message'} // '';
        my $uri_escaped  = quotemeta($uri);
        my $root_escaped = quotemeta($root);
        $msg =~ s/^$uri_escaped:\s//;
        $msg =~ s/^$root_escaped$uri_escaped:\s//;
        $line .= "\"" . csv_safecell($msg) . "\"";
        print $handle "$line\n";
    }
}

###############################################################################
# RFC 4180 quote escaping + CSV formula injection guard.
# Undef becomes empty; 0 and "" are kept (they are valid cell values).
sub csv_safecell {
    my ($celldata) = @_;
    $celldata = '' unless defined $celldata;

    # Excel/LibreOffice treat leading = + - @ TAB CR LF as formulas even in quoted CSV
    if ($celldata =~ /^[=+@\t\r\n-]/) {
        $celldata = "'" . $celldata;
    }

    $celldata =~ s/"/""/g;
    return $celldata;
}

1;

###############################################################################
# SPDX-License-Identifier: GPL-3.0-only
# PURPOSE: Look for multiple unique index files
###############################################################################
use vars qw/$MULTIPLE_INDEX_DB/;

sub nikto_multiple_index_init {
    my $id = { name        => "multiple_index",
               full_name   => "Multiple Index",
               author      => "Tautology",
               description => "Checks for multiple index files",
               hooks       => {
                          start => { method => \&nikto_multiple_index_load, },
                          scan  => { method => \&nikto_multiple_index, },
                            },
               copyright => "2009 Chris Sullo"
               };

    return $id;
}

sub nikto_multiple_index_load {
    $MULTIPLE_INDEX_DB = init_db("db_multiple_index");
}

sub nikto_multiple_index {
    my ($mark) = @_;
    return if $mark->{'terminate'};
    my $dbarray = $MULTIPLE_INDEX_DB || init_db("db_multiple_index");
    my $root    = $mark->{'root'} // '';
    my (%found, %hashes);

    foreach my $item (@$dbarray) {
        return if $mark->{'terminate'};

        # Get file
        my ($res, $content, $error, $request, $response) =
          nfetch($mark, "/$item->{'index'}", "GET", "", "", "", "multiple_index");

        if (($res // '') eq '200' && defined $content) {
            $content = rm_active_content($content, "$root/$item->{'index'}");
            my $hash = LW2::md5($content);
            next unless defined $hash && $hash ne '';
            $found{"$root/$item->{'index'}"} = $hash;
            $hashes{$hash}++;
        }

    }

    my $count = keys(%found);
    if ($count > 1) {

        # make sure we have unique pages
        my $total_unique = scalar keys %hashes;

        # one distinct hash means all responses are effectively the same
        if ($total_unique <= 1) {
            return;
        }
        my $file_list = join(', ', sort keys %found);

        my $msg = "Multiple index files found";
        if ($total_unique < $count) {
            $msg .= " (may not all be unique)";
        }
        else {
            $msg .= " (all unique)";
        }
        # Aggregate finding — no single request/response represents all files
        add_vulnerability($mark, "$msg: $file_list", "740000", "", "GET", "/");
    }
}

1;

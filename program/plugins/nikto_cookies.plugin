###############################################################################
# SPDX-License-Identifier: GPL-3.0-only
# PURPOSE: General HTTP cookie checks
###############################################################################
sub nikto_cookies_init {
    my $id = {
         name        => "cookies",
         full_name   => "HTTP Cookie Internal IP",
         author      => "Sullo",
         description => "Looks for internal IP addresses in cookies returned from an HTTP request.",
         hooks       => { postfetch => { method => \&nikto_cookies_postfetch, }, },
         copyright   => "2010 Chris Sullo"
         };

    return $id;
}

sub nikto_cookies_postfetch {
    my ($mark, $parameters, $request, $response) = @_;

    my $cookies = $response->{'whisker'}->{'cookies'};
    return unless ref($cookies) eq 'ARRAY' && @$cookies;

    # Per-mark, per-cookie-name, per-finding-type dedup
    my $found = ($mark->{'cfound'} ||= {});

    foreach my $c (@$cookies) {
        # Cookie-name is a token: no ";", and the name=value pair starts the
        # header. Unanchored [^=]+ ate "; Path=" from "foo; Path=/; HttpOnly".
        my ($cname, $quoted, $plain) =
          ($c =~ /\A\s*([^\s,;="]+)(?:=\s*(?:"([^"]*)"|([^;]*)))?/);
        next unless defined $cname;
        my $cvalue = defined $quoted ? $quoted : ($plain // '');

        $cname =~ s/^\s+|\s+$//g;
        next if ($cname eq '' || $cname =~ /^;/);

        my $cname_key  = lc($cname);
        my $cname_disp = nikto_cookies_safe_str($cname);
        my $cf         = ($found->{$cname_key} ||= {});

        # secure flag
        if (!$cf->{'secure'} && $mark->{ssl} && $c !~ /(?:^|;\s*)secure(?:\s*;|\s*$)/i) {
            add_vulnerability($mark,
                              $request->{'whisker'}->{'uri'}
                                . ": Cookie $cname_disp created without the secure flag",
                              "999961",
                              "https://developer.mozilla.org/en-US/docs/Web/HTTP/Cookies",
                              $request->{'whisker'}->{'method'},
                              $request->{'whisker'}->{'uri'},
                              $request,
                              $response
                              );
            $cf->{'secure'} = 1;
        }

        # httponly flag
        if (!$cf->{'httponly'} && $c !~ /(?:^|;\s*)httponly(?:\s*;|\s*$)/i) {
            add_vulnerability($mark,
                              $request->{'whisker'}->{'uri'}
                                . ": Cookie $cname_disp created without the httponly flag",
                              "000029",
                              "https://developer.mozilla.org/en-US/docs/Web/HTTP/Cookies",
                              $request->{'whisker'}->{'method'},
                              $request->{'whisker'}->{'uri'},
                              $request,
                              $response
                              );
            $cf->{'httponly'} = 1;
        }

        my @ips = get_ips($c);

        if ($cname_key =~ /^nsc_/) {
            if (my $decoded = decode_netscaler_cookie($cvalue)) {
                push(@ips, $decoded);
            }
        }

        my $ip_found = ($cf->{'ip'} ||= {});
        foreach my $ip (@ips) {
            next unless defined $ip && length($ip);
            next if $ip_found->{$ip};

            my ($valid, $internal, $loopback) = is_ip($ip);
            if ($valid && !$loopback) {
                if ($ip ne $mark->{'ip'}) {
                    my $msg     = "";
                    my $refs    = "";
                    my $ip_disp = nikto_cookies_safe_str($ip);

                    if ($cname_key eq 'arpt') {
                        $msg =
                          "Cisco content switch reveals internal IP address found in the '$cname_disp' cookie. The IP is \"$ip_disp\".";
                        $refs = "CVE-2006-4352";
                    }
                    else {

                        # is it an internal, or just different?
                        my $int = "";
                        if ($internal) { $int = "RFC-1918 "; }
                        $msg = $request->{'whisker'}->{'uri'}
                          . ": ${int}IP address found in the '$cname_disp' cookie. The IP is \"$ip_disp\".";
                    }
                    add_vulnerability($mark, $msg, "999991", $refs,
                                      $request->{'whisker'}->{'method'},
                                      $request->{'whisker'}->{'uri'},
                                      $request, $response);
                    $ip_found->{$ip} = 1;
                }
            }
        }
    }
}

sub decode_netscaler_cookie {
    my ($cookie_val) = @_;
    return unless defined $cookie_val && length($cookie_val);

    # Format: 8-char pad + 8-char encoded IP + ... + 4-char encoded port
    my ($ip_hex) = ($cookie_val =~ /[0-9a-f]{8}([0-9a-f]{8}).*[0-9a-f]{4}$/i);
    return unless defined $ip_hex;

    my $ip_value        = hex($ip_hex) ^ 0x03081e11;
    my $ip_hex_zero_pad = sprintf("%08X", $ip_value);
    return
        hex(substr($ip_hex_zero_pad, 0, 2)) . "."
      . hex(substr($ip_hex_zero_pad, 2, 2)) . "."
      . hex(substr($ip_hex_zero_pad, 4, 2)) . "."
      . hex(substr($ip_hex_zero_pad, 6, 2));
}

# Strip controls / limit length so cookie data cannot break report/console output
sub nikto_cookies_safe_str {
    my ($s) = @_;
    $s = '' unless defined $s;
    $s =~ s/[\x00-\x1f\x7f]//g;
    return length($s) > 256 ? substr($s, 0, 256) : $s;
}

1;

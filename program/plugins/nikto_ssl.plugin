###############################################################################
# SPDX-License-Identifier: GPL-3.0-only
# PURPOSE: Test certificate information
###############################################################################
sub nikto_ssl_init {
    my $id = { name        => "ssl",
               full_name   => "SSL and cert checks",
               author      => "Sullo",
               description => "Perform checks on SSL/Certificates",
               hooks       => { scan => { method => \&nikto_ssl, } },
               copyright   => "2010 Chris Sullo"
               };
    return $id;
}

sub nikto_ssl {
    my ($mark) = @_;
    return if $mark->{'terminate'};
    return unless $mark->{ssl};

    my @cn_names;
    my @san_names;
    my $match             = 0;
    my $wildcard_reported = 0;
    my $hostname_cmp      = nikto_ssl_idna_to_ascii($mark->{'hostname'} || '');
    $hostname_cmp =~ s/\.$//;

    # Extract CN from subject (oneline /CN=…/ or comma DN; optional spaces)
    push @cn_names, nikto_ssl_extract_cn($mark->{'ssl_cert_subject'})
      if defined $mark->{'ssl_cert_subject'};

    # Extract SAN names
    if (defined $mark->{'ssl_cert_altnames'} && $mark->{'ssl_cert_altnames'} ne '') {
        foreach my $n (split(/\s*,\s*/, $mark->{'ssl_cert_altnames'})) {
            $n =~ s/^\s+|\s+$//g;
            $n =~ s/^dns://i;
            push(@san_names, $n) if length($n);
        }
    }

    # RFC 6125: if DNS SANs are present, verify against those only
    my %seen;
    my @all_names = grep { length($_) && !$seen{$_}++ } (@san_names ? @san_names : @cn_names);

    # Nothing to compare against (cert fields missing / no usable names)
    return unless @all_names;

    # Create detailed name lists for error messages (sanitize untrusted cert data)
    my $cn_list  = @cn_names  ? join(", ", map { nikto_ssl_safe_str($_) } @cn_names)  : "none";
    my $san_list = @san_names ? join(", ", map { nikto_ssl_safe_str($_) } @san_names) : "none";

    foreach my $cert_name (@all_names) {
        my $cert_name_cmp = nikto_ssl_idna_to_ascii($cert_name);
        $cert_name_cmp =~ s/\.$//;

        # straight up match
        if ($hostname_cmp eq $cert_name_cmp) {
            $match = 1;
        }

        # wildcard cert (must be *.domain — not a bare * prefix)
        elsif ($cert_name_cmp =~ /^\*\./) {
            if (!$wildcard_reported) {
                add_vulnerability($mark,
                                  "/: Server is using a wildcard certificate: "
                                    . nikto_ssl_safe_str($cert_name),
                                  "999992",
                                  "https://en.wikipedia.org/wiki/Wildcard_certificate"
                                  );
                $wildcard_reported = 1;
            }
            $cert_name_cmp =~ s/^\*\.//;
            next unless length($cert_name_cmp);
            $cert_name_cmp = rquote($cert_name_cmp);

            # Require the separating dot; exactly one label (no dots in prefix).
            # Apex (example.com) must not match *.example.com.
            if ($hostname_cmp =~ /^[^.]+\.$cert_name_cmp\z/) {
                $match = 1;
            }
        }
        last if $match;
    }

    if (!$match) {
        my $host_disp = nikto_ssl_safe_str($mark->{'hostname'} || '');
        my $error_msg = "/: Hostname '$host_disp' does not match certificate names";
        $error_msg .= " (CN: $cn_list, SAN: $san_list)";
        add_vulnerability($mark, $error_msg, "999993",
                          "https://cwe.mitre.org/data/definitions/297.html");
    }
}

# Strip controls / limit length so cert/host data cannot break report/console output
sub nikto_ssl_safe_str {
    my ($s) = @_;
    $s = '' unless defined $s;
    $s =~ s/[\x00-\x1f\x7f]//g;
    return length($s) > 256 ? substr($s, 0, 256) : $s;
}

# Pull CN values from an X.509 subject string.
# Handles OpenSSL oneline (/CN=host/O=…), comma DNs (CN=host, O=…), and "CN = host".
sub nikto_ssl_extract_cn {
    my ($subject) = @_;
    return () unless defined $subject && $subject ne '';

    my @cns;
    while ($subject =~ /\bCN\s*=\s*([^,\/]+)/gi) {
        my $cn = $1;
        $cn =~ s/^\s+|\s+$//g;
        $cn =~ s/^"(.*)"$/$1/;
        push @cns, $cn if length($cn);
    }
    return @cns;
}

###############################################################################
# Minimal IDNA ToASCII (per-label Punycode). No CPAN — RFC 3492 encode only.
# Skips full IDNA2008 validation; good enough for hostname/cert matching.
###############################################################################
sub nikto_ssl_idna_to_ascii {
    my ($name) = @_;
    return '' unless defined $name && $name ne '';

    # Already pure ASCII — just lowercase (DNS case-insensitive)
    return lc($name) unless $name =~ /[^\x00-\x7F]/;

    # Ensure character semantics (UTF-8 octets → Unicode string)
    unless (utf8::is_utf8($name)) {
        my $copy = $name;
        utf8::decode($copy) or return lc($name);    # leave as-is if not valid UTF-8
        $name = $copy;
    }

    # NFC when Unicode::Normalize is available (core module)
    eval {
        require Unicode::Normalize;
        $name = Unicode::Normalize::NFC($name);
        1;
    };

    my @out;
    foreach my $label (split(/\./, $name, -1)) {
        if ($label eq '' || $label !~ /[^\x00-\x7F]/) {
            push @out, lc($label);
            next;
        }

        # Already ACE
        if ($label =~ /^xn--/i && $label !~ /[^\x00-\x7F]/) {
            push @out, lc($label);
            next;
        }

        my $encoded = eval { nikto_ssl_punycode_encode($label) };
        if (!defined $encoded || $@) {
            # Fall back to lowercase original so matching can still proceed
            push @out, lc($label);
            next;
        }
        push @out, 'xn--' . $encoded;
    }
    return join('.', @out);
}

# RFC 3492 Punycode encode (Bootstring parameters for Punycode)
sub nikto_ssl_punycode_encode {
    my ($input) = @_;
    my @input = unpack('U*', $input);
    return '' unless @input;

    my $base         = 36;
    my $tmin         = 1;
    my $tmax         = 26;
    my $skew         = 38;
    my $damp         = 700;
    my $initial_bias = 72;
    my $initial_n    = 0x80;
    my $delimiter    = '-';

    my $encode_digit = sub {
        my ($d) = @_;
        return chr($d + 0x61) if $d < 26;    # a-z
        return chr($d - 26 + 0x30);          # 0-9
    };

    my $adapt = sub {
        my ($delta, $numpoints, $firsttime) = @_;
        $delta = $firsttime ? int($delta / $damp) : int($delta / 2);
        $delta += int($delta / $numpoints);
        my $k = 0;
        while ($delta > int((($base - $tmin) * $tmax) / 2)) {
            $delta = int($delta / ($base - $tmin));
            $k += $base;
        }
        return $k + int((($base - $tmin + 1) * $delta) / ($delta + $skew));
    };

    my @output;
    foreach my $c (@input) {
        if ($c < 0x80) {
            push @output, chr(($c >= 0x41 && $c <= 0x5A) ? $c + 0x20 : $c);
        }
    }
    my $h = my $b = scalar @output;
    push @output, $delimiter if $b > 0 && $h < scalar @input;

    my $n     = $initial_n;
    my $delta = 0;
    my $bias  = $initial_bias;

    while ($h < scalar @input) {
        my $m = undef;
        foreach my $c (@input) {
            $m = $c if $c >= $n && (!defined $m || $c < $m);
        }
        die "punycode: overflow" if !defined $m;

        my $incr = ($m - $n) * ($h + 1);
        die "punycode: overflow" if $delta > (~0 >> 1) - $incr;
        $delta += $incr;
        $n = $m;

        foreach my $c (@input) {
            if ($c < $n) {
                die "punycode: overflow" if ++$delta == 0;
            }
            if ($c == $n) {
                my $q = $delta;
                for (my $k = $base ; ; $k += $base) {
                    my $t =
                        ($k <= $bias + $tmin) ? $tmin
                      : ($k >= $bias + $tmax) ? $tmax
                      :                         $k - $bias;
                    last if $q < $t;
                    push @output, $encode_digit->($t + (($q - $t) % ($base - $t)));
                    $q = int(($q - $t) / ($base - $t));
                }
                push @output, $encode_digit->($q);
                $bias  = $adapt->($delta, $h + 1, ($h == $b));
                $delta = 0;
                $h++;
            }
        }
        $delta++;
        $n++;
    }

    return join('', @output);
}

1;

###############################################################################
# SPDX-License-Identifier: GPL-3.0-only
# PURPOSE: Check for outdated items in banner
###############################################################################
sub nikto_outdated_init {
    my $id = { name        => "outdated",
               full_name   => "Outdated",
               author      => "Sullo",
               description => "Checks to see whether the web server is the latest version.",
               copyright   => "2008 Chris Sullo",
               hooks       => { scan => { method => \&nikto_outdated, }, },
               };
    return $id;
}

sub nikto_outdated {
    my ($mark) = @_;
    return if $mark->{'terminate'};

    # Local copy — never mutate $mark->{'banner'} (banner-change FP otherwise)
    my $banner = $mark->{'banner'} // '';

    # If banner has nothing that can be a version... return
    return if $banner !~ /(?:\d|\/|\.)/;

    # Platform tags are not part of product/version (e.g. IIS "Microsoft-IIS/10.0 (Win64)")
    $banner =~ s/\s*\(Win(?:32|64)\)//gi;

    # Normalize a few vendors whose banners are not "Name/ver" tokens, then
    # match db_outdated keys against whole haystacks. Do not space-split
    # first: that turns "Alpha Anywhere Application Server/12.0" into
    # "Server/12.0" and lets a short key steal a multi-word product.
    my @haystacks;

    if ($banner =~ /weblogic/i) {
        my @T = split(/ /, $banner);
        if (defined $T[0] && $T[0] ne '' && defined $T[1] && $T[1] ne '') {
            push @haystacks, $T[0] . '/' . $T[1];
        }
    }
    elsif ($banner =~ /sitescope/i) {
        my @T = split(/ /, $banner);
        if (defined $T[0] && $T[0] ne '') {
            push @haystacks, $T[0];
        }
    }
    elsif ($banner =~ /jetty\(/i) {
        if ($banner =~ /Jetty\(([0-9a-zA-Z.\-]+)\)/i) {
            push @haystacks, 'Jetty/' . $1;
        }
    }
    elsif (   ($banner !~ /\s/)
           && ($banner =~ /\/.*\//)
           && ($banner =~ /\(/)) {

        # WEBrick-style: "WEBrick/1.3.1(Ruby/1.8.7/...)" → spaces, then match
        my $h = $banner;
        $h =~ tr/()/  /;
        push @haystacks, $h;
    }
    else {
        push @haystacks, $banner;
    }

    # Headers / X-Powered-By may already have planted extra component strings.
    # Skip any that are already inside a banner haystack (the matcher covers them).
    foreach my $c (keys %{ $mark->{'components'} || {} }) {
        next if $c eq '' || is_platform_component($c) || $c =~ /^cache-/i;
        my $cl = lc($c);
        my $covered = 0;
        foreach my $h (@haystacks) {
            if (index(lc($h), $cl) >= 0) {
                $covered = 1;
                last;
            }
        }
        push @haystacks, $c unless $covered;
    }

    foreach my $hay (@haystacks) {
        next if $hay eq '' || $hay =~ /^cache-/i || is_platform_component($hay);

        my @matches = outdated_find_matches($hay);
        if (!@matches) {
            $mark->{'components'}->{$hay} = 2;
            next;
        }

        foreach my $m (@matches) {
            my $BI = $m->{'running'};
            my $V  = $m->{'key'};
            $mark->{'components'}->{$BI} = 1;

            foreach my $v (keys %{ $OVERS{$V} }) {
                next if $v eq "";
                if (vereval($v, $BI, $V, $mark)) {
                    my $msg = $OVERS{$V}{$v}{'msg'};
                    $msg =~ s/\@RUNNING_VER/$BI/g;
                    $msg =~ s/\@CURRENT_VER/$v/g;
                    chomp($msg);
                    add_vulnerability($mark, $msg, $OVERS{$V}{$v}{'tid'},
                                      "", "HEAD", "/", "", "", "Content match");
                }
            }
        }
    }
    return;
}

# Match db_outdated keys against one banner/header string.
# Keys must start at a token boundary (string start, whitespace, (, ;, ,).
# When two matches overlap, the longer key wins (Apache Tomcat/ vs Apache/,
# Alpha Anywhere Application Server/... vs Server/).
sub outdated_find_matches {
    my ($haystack) = @_;
    return () unless defined $haystack && length($haystack);

    my @keys =
      sort { length($b) <=> length($a) || $a cmp $b } grep { $_ ne '' } keys %OVERS;
    my @spans;
    my @found;

  KEY: foreach my $key (@keys) {
        my $re;
        eval { $re = qr/$key/i };
        next KEY if $@ || !defined $re;

        my $search = $haystack;
        while ($search =~ /$re/g) {
            my $start   = $-[0];
            my $key_end = $+[0];

            if ($start > 0) {
                my $prev = substr($search, $start - 1, 1);
                next unless $prev =~ /[\s(;,]/;
            }

            my $ver_len = 0;
            my $after   = substr($search, $key_end);
            if ($after =~ /^([^\s]+)/) {
                $ver_len = length($1);
            }
            my $end = $key_end + $ver_len;

            my $overlap = 0;
            foreach my $sp (@spans) {
                if ($start < $sp->[1] && $end > $sp->[0]) {
                    $overlap = 1;
                    last;
                }
            }
            next if $overlap;

            push @spans, [ $start, $end ];
            push @found,
              { key     => $key,
                running => substr($search, $start, $end - $start),
              };
        }
    }
    return @found;
}

# True for OS/platform tokens that must not become update candidates
sub is_platform_component {
    my ($s) = @_;
    return 0 unless defined $s && $s ne '';
    return 1 if $s =~ /^(?:\(?Win(?:32|64)\)?|Linux-Mandrake)$/i;
    return 0;
}

# do version evaluation
# arguments:
#	0: latest version as defined in db_outdated
#	1: running item being evaluated
#	2: item being matched against in db_outdated
#	3: mark hash
sub vereval {
    my $mark = $_[3];
    return 0 unless defined $_[2] && length($_[2]);

    # split both by last char of $_[2], as it is the name to version separator
    my $sepr = substr($_[2], (length($_[2]) - 1), 1);
    nprint("nikto_outdated.plugin: verstring: $_[2], sepr:$sepr",
           "d", "outdated", ($mark->{'hostname'}, $mark->{'ip'}, $mark->{'displayname'}));

    my $CURRENT      = lc($_[0] // '');
    my $RUNNING      = lc($_[1] // '');
    my $CURRENT_ORIG = $CURRENT;
    my $RUNNING_ORIG = $RUNNING;

    nprint("nikto_outdated.plugin: \$CURRENT:$CURRENT:\$RUNNING:$RUNNING:",
           "d", "outdated", ($mark->{'hostname'}, $mark->{'ip'}, $mark->{'displayname'}));

    my @T = split(/\Q$sepr\E/, $CURRENT);
    $CURRENT = $T[$#T];                        # should be version...
    @T       = split(/\Q$sepr\E/, $RUNNING);
    $RUNNING = $T[$#T];                        # should be version...

    # convert alphas to numerics so we can do a real comparison
    $CURRENT =~ s/([^0-9\.]){1}/"." . ord($1) . "."/eg;
    $RUNNING =~ s/([^0-9\.]){1}/"." . ord($1) . "."/eg;
    $RUNNING =~ s/\.+/\./g;
    $CURRENT =~ s/\.+/\./g;
    $RUNNING =~ s/^\.//;
    $CURRENT =~ s/^\.//;
    $RUNNING =~ s/\.$//;
    $CURRENT =~ s/\.$//;

    nprint("nikto_outdated.plugin: \$CURRENT:$CURRENT:\$RUNNING:$RUNNING\: (after numberifcation)",
           "d", "outdated", $mark->{'hostname'}, $mark->{'ip'}, $mark->{'displayname'});

    my (@CUR, @RUN);
    # Letters were already converted to ordinals above; always compare numerically.
    @CUR = split(/\./, $CURRENT);
    @RUN = split(/\./, $RUNNING);

    # start with 0... eval each in turn...
    for (my $i = 0 ; $i <= $#CUR ; $i++) {
        my $c = $CUR[$i] // '';
        my $r = $RUN[$i] // '';
        nprint("nikto_outdated.plugin: major compare: \$CUR[$i]:$c: \$RUN[$i]:$r:",
               "d", "outdated", $mark->{'hostname'}, $mark->{'ip'}, $mark->{'displayname'});
        # Running banner has fewer components (Apache/2.4 vs DB 2.4.62).
        # Truncation is not evidence of being outdated.
        if ($r eq "") { return 0; }
        if ($c > $r)  { return 1; }    # running is older
        if ($c < $r)                   # running is newer
        {
            my $string = $_[1];
            $string =~ s/\s/\%20/g;
            $mark->{'components'}->{$string} = 2;
            return 0;
        }
    }
    return 0;    # running is the same version if we make it here
}

1;

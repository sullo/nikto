###############################################################################
# SPDX-License-Identifier: GPL-3.0-only
# PURPOSE: Try put and then delete a file
###############################################################################
sub nikto_put_del_test_init {
    my $id = { name        => "put_del_test",
               full_name   => "Put/Delete test",
               author      => "Sullo",
               description =>
                 "Attempts to upload and delete files through the PUT and DELETE HTTP methods.",
               hooks     => { scan => { method => \&nikto_put_del_test, }, },
               copyright => "2008 Chris Sullo"
               };
    return $id;
}

sub nikto_put_del_test {
    my ($mark) = @_;
    return if $mark->{'terminate'};

    my $marker = 'This was a Nikto test.';
    my $uri    = "/nikto-test-" . LW2::utils_randstr(8) . ".html";

    my ($res, $content, $error, $request, $response) =
      nfetch($mark, $uri, "PUT", $marker, "", "", "put_del_test: PUT");

    # PUT may return 200 OK, 201 Created, or 204 No Content
    my $put_ok = (($res // '') eq '200' || ($res // '') eq '201' || ($res // '') eq '204');
    return unless $put_ok;

    my $put_request  = $request;
    my $put_response = $response;
    my $put_confirmed = 0;

    return if $mark->{'terminate'};
    ($res, $content, $error, $request, $response) =
      nfetch($mark, $uri, "GET", "", "", "", "put_del_test: GET");
    if (defined $content && $content =~ /\Q$marker\E/) {
        $put_confirmed = 1;
        add_vulnerability(
            $mark,
            "$uri: HTTP method 'PUT' allows clients to save files on the web server.",
            "999995",
            "https://portswigger.net/kb/issues/00100900_http-put-method-is-enabled",
            "PUT",
            $uri,
            $put_request,
            $put_response
            );
    }

    # Always attempt DELETE after a successful PUT status so we do not leave
    # an orphaned upload when GET verify fails (auth, delay, soft deny).
    return if $mark->{'terminate'};
    ($res, $content, $error, $request, $response) =
      nfetch($mark, $uri, "DELETE", "", "", "", "put_del_test: DELETE");
    my $del_request  = $request;
    my $del_response = $response;

    return unless $put_confirmed;
    return if $mark->{'terminate'};
    ($res, $content, $error, $request, $response) =
      nfetch($mark, $uri, "GET", "", "", "", "put_del_test: GET");

    # Confirm removal via GET (DELETE status varies: 200/201/202/204/404/…)
    if (defined $res && $res ne '' && !(defined $content && $content =~ /\Q$marker\E/)) {
        add_vulnerability(
            $mark,
            "$uri: HTTP method 'DELETE' allows clients to delete files on the web server.",
            "999994",
            "https://cwe.mitre.org/data/definitions/650.html",
            "DELETE",
            $uri,
            $del_request,
            $del_response
            );
    }
}

1;

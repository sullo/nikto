# PURPOSE: Various file operations
###############################################################################
sub nikto_fileops_init {
    my $id = { name        => "fileops",
               full_name   => "File Operations",
               author      => "Sullo",
               description => "Saves results to a text file.",
               copyright   => "2012 Chris Sullo",
               };
    return $id;
}

###############################################################################
# save a result to text file
sub save_item {
    require JSON::PP;
    my ($resulthash, $message, $request, $response) = @_;
    return unless defined $resulthash->{'mark'}
      && ($resulthash->{'mark'}->{'save_prefix'} // '') ne '';
    my $fn =
        $resulthash->{'mark'}->{'save_dir'} . "/"
      . $resulthash->{'mark'}->{'save_prefix'}
      . $resulthash->{'nikto_id'} . ".txt";

    my $save_fh;
    unless (open($save_fh, ">>", $fn)) {
        nprint("+ ERROR: Unable to open savefile '$fn': $!");
        return;
    }

    my $has_request =
      ref($request) eq 'HASH' && (($request->{'whisker'}{'method'} // '') ne '');
    my $has_response =
      ref($response) eq 'HASH' && (($response->{'whisker'}{'protocol'} // '') ne '');

    print $save_fh $VARIABLES{'DIV'} . "\n";
    print $save_fh "			  Information\n";
    print $save_fh $VARIABLES{'DIV'} . "\n";
    print $save_fh "Test ID:  \t" . save_safe_line($resulthash->{'nikto_id'}) . "\n";
    print $save_fh "References: \t" . save_safe_line($resulthash->{'refs'}) . "\n";
    print $save_fh "Message:  \t" . save_safe_line($message) . "\n";
    print $save_fh "Reason:   \t" . save_safe_line($resulthash->{'reason'}) . "\n";
    print $save_fh $VARIABLES{'DIV'} . "\n";
    print $save_fh "			  Request\n";
    print $save_fh $VARIABLES{'DIV'} . "\n";

    if (!$has_request) {
        print $save_fh "Not Applicable\n";
    }
    else {
        print $save_fh rebuild_request($request);
    }
    print $save_fh "\n";
    print $save_fh $VARIABLES{'DIV'} . "\n";
    print $save_fh "			  Response\n";
    print $save_fh $VARIABLES{'DIV'} . "\n";
    if (!$has_response) {
        print $save_fh "Not Applicable\n";
    }
    else {
        print $save_fh rebuild_response($response);
    }

    print $save_fh $VARIABLES{'DIV'} . "\n";
    print $save_fh "			  Data Objects\n";
    print $save_fh $VARIABLES{'DIV'} . "\n";
    my $json = JSON::PP->new->utf8(1)->allow_nonref(1);
    if ($has_request) {
        print $save_fh "REQUEST:" . $json->encode($request) . "\n";
    }
    if ($has_response) {
        print $save_fh "RESPONSE:" . $json->encode($response) . "\n";
    }
    close($save_fh);
}

# Collapse controls/newlines so Information fields stay single-line
sub save_safe_line {
    my ($s) = @_;
    $s = '' unless defined $s;
    $s =~ s/[\x00-\x1f\x7f]+/ /g;
    $s =~ s/ +/ /g;
    $s =~ s/^ | $//g;
    return $s;
}

###############################################################################
# get the prefix for all current host's save files
sub save_getprefix {
    my ($mark) = @_;
    my $prefix = $mark->{'displayname'} . '_' . $mark->{'port'};
    $prefix =~ s/,/\-/g;
    $prefix =~ s/[^a-zA-Z0-9\.\-\_]/_/g;
    $prefix =~ s/_+/_/g;
    my $now = date_disp(time());
    $now =~ s/\s.*$//;
    $prefix .= "_" . $now . "_";
    return $prefix;
}

###############################################################################
# Define/create the save directory
sub save_createdir {
    my ($savedir, $mark) = @_;
    if ($savedir eq '.') {
        $savedir = 'savedir_' . $mark->{'displayname'} . '_' . $mark->{'port'};
        $savedir =~ s/,/\-/g;
        $savedir =~ s/[^a-zA-Z0-9\.\-\_]/_/g;
        $savedir =~ s/_+/_/g;
        my $now = date_disp(time());
        $now =~ s/[^0-9-]/-/g;
        $savedir .= "_" . $now;
    }
    elsif (-f $savedir) {
        nprint("+ ERROR: Directory from -Savedir is a file.");
        return '';
    }

    # create?
    if (!-d $savedir) {
        if (!mkdir($savedir)) {
            nprint("+ ERROR: Unable to create -Save directory '$savedir': $!",
                   "", undef, ($mark->{'hostname'}, $mark->{'ip'}, $mark->{'displayname'}));
            return '';
        }
    }
    return $savedir;
}

###############################################################################
# Parse input host files
sub parse_hostfile {
    my ($file) = @_;
    my (@results, $hostdesc);
    my $nmap = 0;

    my $in_fh;
    open($in_fh, "<", $file) || die "+ ERROR: Cannot open '$file':$!\n";
    while (<$in_fh>) {

        # Check whether this is a greppable nmap file
        chomp;
        $nmap = 1 if (/^# Nmap/);
        s/\#.*$//;
        if ($_ eq "") { next; }

        # Parse for nmap files
        if ($nmap) {
            unless (/Host/ && /Ports/ && /open/ && /(?:http|ssl)/i) {
                next;
            }

            # parse out the line
            my @fields = split("\t", $_);

            # Get the host name only if parsing succeeded, so stale captures are never reused
            my ($host_ip, $host_name) =
              $fields[0] =~ /Host:\s+($LW2::IPv4_re|$LW2::IPv6_re_inc_zoneid)\s+\(([^\)]+)?\)/;
            if (!defined $host_ip) {
                nprint("\tUnable to parse Nmap host field: $fields[0]", "d");
                next;
            }
            $hostdesc = (defined $host_name && $host_name ne "") ? $host_name : $host_ip;

            # Parse the ports list from:
            # Host: 1.0.0.0 ()  Ports: 80/open/tcp//http///, 8000/open/tcp//http-alt///
            next unless defined $fields[1] && $fields[1] ne '';
            $fields[1] =~ s/^Ports: //;
            my @ports = parse_csv($fields[1]);
            foreach my $nmp (@ports) {
                unless (   ($nmp =~ /\/open\/tcp/)
                        && (($nmp =~ /^(?:\s+)?(?:80|443)\//) || ($nmp =~ /(?:http|ssl)/i))) {
                    nprint("\tNon web port identified: $hostdesc:$nmp",
                           "d", "fileops", ($hostdesc));
                    next;
                }
                # Capture only if parsing succeeded, so stale $1 is never reused
                my ($port) = $nmp =~ /^(?:\s+)?(\d+)\//;
                if (!defined $port) {
                    nprint("\tUnable to parse Nmap port field: $nmp", "d");
                    next;
                }
                nprint("+ Nmap Input Queued: $hostdesc:$port");
                push(@results, $hostdesc . ":" . $port);
            }
        }
        else {
            # just add it to the list
            push(@results, $_);
        }
    }
    close($in_fh);
    return (@results);
}

1;

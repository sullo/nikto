###############################################################################
# SPDX-License-Identifier: GPL-3.0-only
# PURPOSE: JSON Reporting - Multi-host support
###############################################################################
our $JSONRPT_ALL  = [];       # Arrayref to hold all hosts' reports
our $JSONRPT_CURR = undef;    # Scalarref to current host's report

use JSON::PP;
use Time::Piece;
use Time::Seconds;

###############################################################################
sub nikto_report_json_init {

    my $id = { name              => "report_json",
               full_name         => "JSON reports",
               author            => "Sullo",
               description       => "Produces a JSON report.",
               report_head       => \&json_open,
               report_host_start => \&json_host_start,
               report_host_end   => \&json_host_end,
               report_close      => \&json_close,
               report_item       => \&json_item,
               report_ssl_info   => \&json_ssl_info,
               report_format     => 'json',
               copyright         => "2025 Chris Sullo"
               };
    return $id;
}

###############################################################################
# open output file
sub json_open {
    my ($file) = @_;
    if ($file eq '') {
        print STDERR "+ ERROR: Output file not specified.\n";
        exit;
    }

    # Open file with lexical handle (read-write mode for JSON)
    my $fh;
    open($fh, "+>", $file) || die "+ ERROR: Unable to open '$file' for write: $!\n";

    # Enable autoflush
    $fh->autoflush(1);

    return $fh;
}

###############################################################################
# start output for a host
sub json_host_start {
    my ($handle, $mark) = @_;

    # Get current time with timezone
    my $current_time = localtime;
    my $start_time   = $mark->{'start_time'} ? localtime($mark->{'start_time'}) : $current_time;

    $JSONRPT_CURR = { host            => $mark->{'vhost'} ? $mark->{'vhost'} : $mark->{'hostname'},
                      ip              => $mark->{'ip'},
                      port            => $mark->{'port'},
                      server_banner   => $mark->{'banner'},
                      start_time      => $start_time->strftime('%Y-%m-%d %H:%M:%S %z'),
                      vulnerabilities => []
                      };

    # Add current host report to the array of all hosts
    push @$JSONRPT_ALL, $JSONRPT_CURR;
    return;
}

###############################################################################
# write SSL info
sub json_ssl_info {
    my ($handle, $mark) = @_;

    # Update the current host report with SSL info
    return unless defined $JSONRPT_CURR;

    # Extract CN from subject. RDNs are separated by ',' or '/', and a CN may
    # legitimately contain spaces, so only those two are terminators.
    my $cn = '';
    if (defined $mark->{'ssl_cert_subject'}
        && $mark->{'ssl_cert_subject'} =~ /\bCN\s*=\s*([^,\/]+)/i) {
        $cn = $1;
        $cn =~ s/^\s+|\s+$//g;
    }

    $JSONRPT_CURR->{'ssl_info'} = { ciphers  => $mark->{'ssl_cipher'}       || '',
                                    issuer   => $mark->{'ssl_cert_issuer'}  || '',
                                    subject  => $mark->{'ssl_cert_subject'} || '',
                                    cn       => $cn,
                                    altnames => $mark->{'ssl_cert_altnames'} || ''
                                    };
}

###############################################################################
# end output for a host
sub json_host_end {
    my ($handle, $mark) = @_;
    return unless defined $JSONRPT_CURR;

    # end_time may be unset on incomplete marks; use now rather than
    # comparing undef with eq '' (warning) or localtime(undef) (epoch).
    my $end_time =
      (defined $mark->{'end_time'} && $mark->{'end_time'} ne '')
      ? localtime($mark->{'end_time'})
      : localtime;

    $JSONRPT_CURR->{'end_time'} = $end_time->strftime('%Y-%m-%d %H:%M:%S %z');
    return;
}

###############################################################################
# close output file
sub json_close {
    my ($handle, $mark) = @_;
    my $json_encoder = JSON::PP->new->utf8->canonical->pretty->convert_blessed;
    my $json_output  = $json_encoder->encode($JSONRPT_ALL);
    print $handle $json_output;
    close($handle);
    return;
}

###############################################################################
# print an item
sub json_item {
    my ($handle, $mark, $item) = @_;
    return unless defined $JSONRPT_CURR;

    my $uri  = $item->{'uri'}  // '';
    my $root = $mark->{'root'} // '';
    my $full_uri = $uri;
    if ($uri ne '' && $root ne '' && $uri !~ /^\Q$root\E(?:\/|$)/) {
        $full_uri = $root . $uri;
    }

    my $msg          = $item->{'message'} // '';
    my $uri_escaped  = quotemeta($uri);
    my $root_escaped = quotemeta($root);
    $msg =~ s/^$uri_escaped:\s//;
    $msg =~ s/^$root_escaped$uri_escaped:\s//;

    push @{ $JSONRPT_CURR->{'vulnerabilities'} },
      { id         => $item->{'nikto_id'},
        references => $item->{'refs'},
        method     => $item->{'method'},
        url        => $full_uri,
        msg        => $msg
        };
}

1;

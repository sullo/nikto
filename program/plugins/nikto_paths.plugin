###############################################################################
# SPDX-License-Identifier: GPL-3.0-only
# PURPOSE: Look at paths to help populate variables
###############################################################################
sub nikto_paths_init {
    my $id = { name        => "paths",
               full_name   => "Path Search",
               author      => "Sullo",
               description => "Look at link paths to help populate variables",
               hooks       => {
                          recon => { method => \&nikto_paths,
                                     weight => 20,
                                     },
                            },
               copyright => "2012 Chris Sullo"
               };
    return $id;
}

sub nikto_paths {
    my ($mark) = @_;
    return if $mark->{'terminate'};
    my (%DIRS, %FILES);

    # Follow redirects for this probe only
    local $CLI{'followredirects'} = 1;
    my ($res, $content) = nfetch($mark, "/", "GET", "", "", "", "Paths");

    if (defined $content && length $content) {

        # get links
        my @links = LW2::html_link_extractor($content);
        my %FULL_LINKS;
        my %valid_hosts = map { lc($_) => 1 }
          grep { defined $_ && $_ ne '' }
          ($mark->{'hostname'}, $mark->{'ip'}, $mark->{'vhost'}, $mark->{'ident'});
        foreach my $link (@links) {

            # Absolute http(s) or protocol-relative (//host/...): keep path
            # only when host is this target. Protocol-relative must not skip
            # the host check just because the string starts with '/'.
            if ($link =~ m{^//} || ($link !~ /^\// && $link =~ m{^https?://}i)) {
                my $abs = ($link =~ m{^//} ? "http:$link" : $link);
                my @uri = LW2::uri_split($abs);
                if (defined $uri[2] && exists $valid_hosts{ lc($uri[2]) }) {
                    $link = $uri[0] // '';
                }
                else {
                    next;
                }
            }
            elsif ($link !~ m{^/}) {
                # Document was fetched as "/"; resolve relative hrefs from root
                $link = "/$link";
            }

            # normalize
            $link = LW2::uri_normalize($link);
            # Path-only (single leading /) — reject schemes, //host, etc.
            next unless defined $link && $link =~ m{\A/(?!/)};

            $FULL_LINKS{$link} = 1;

            # split dirs / files
            my $dir = LW2::uri_get_dir($link);
            $dir = '' unless defined $dir;
            my $file = $link;
            if ($dir ne '' && index($file, $dir) == 0) {
                substr($file, 0, length($dir)) = '';
            }

            if ($file ne '') {
                $file =~ s/\\//g;
                $FILES{$file} = 1;
            }

            if (($dir ne '') && ($dir ne '/')) {
                $dir =~ s/\\//g;
                $DIRS{$dir} = 1;
            }
        }

        # Use shared path matching logic
        path_matcher($mark, \%FILES, \%DIRS, \%FULL_LINKS);

    }
}

1;
